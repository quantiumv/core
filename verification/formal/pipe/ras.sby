# qv_ras: the circular stack against the shift stack (ras_props.sv): k-induction proof, deep BMC, covers.
# Run with run.sh, or: sby -f ras.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 6
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_pkg.sv qv_ras.sv ras_props.sv --top ras_props
prep -top ras_props

