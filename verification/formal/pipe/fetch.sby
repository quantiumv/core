# qv_fetch properties (fetch_props.sv): k-induction proof, plus a deep
# BMC as a cross-check. Run with run.sh, or: sby -f fetch.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 8
bmc: mode bmc
bmc: depth 24
cover: mode cover
cover: depth 24

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_pkg.sv qv_fetch.sv fetch_props.sv --top fetch_props
prep -top fetch_props

