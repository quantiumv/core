# qv_align2 (O8b, the aligner over two fetch-buffer entries) against a model fetch buffer (align2_props.sv):
# k-induction proof (the lemmas tie the aligner's state to the model, so depth 4 suffices), a BMC cross-check (depth 6:
# the mutants of run.sh fail by step 4) and the covers, on bitwuzla. Run with run.sh, or: sby -f align2.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 4
bmc: mode bmc
bmc: depth 6
cover: mode cover
cover: depth 14

[engines]
smtbmc bitwuzla

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_pkg.sv qv_align2.sv align2_props.sv --top align2_props
prep -top align2_props

[files]
../../../design/pipe/qv_pkg.sv
../../../design/pipe/qv_align2.sv
align2_props.sv
