# qv_rs properties (rs_props.sv): k-induction proof, deep BMC, covers.
# Run with run.sh, or: sby -f rs.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 6
bmc: mode bmc
bmc: depth 8
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit -D QV_ROB_MAX=8 qv_pkg.sv qv_rs.sv rs_props.sv --top rs_props
prep -top rs_props

[files]
../../../design/pipe/qv_pkg.sv
../../../design/pipe/qv_rs.sv
rs_props.sv
