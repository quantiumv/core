# qv_sb properties (sb_props.sv): k-induction proof, deep BMC, covers.
# Run with run.sh, or: sby -f sb.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 12
bmc: mode bmc
bmc: depth 30
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_sb.sv sb_props.sv --top sb_props
prep -top sb_props

[files]
../../../design/pipe/qv_sb.sv
