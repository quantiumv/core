# qv_issue + qv_rob through kills (kill_props.sv): k-induction proof, deep BMC, covers.
# Run with run.sh, or: sby -f kill.sby
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 4
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 14

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_pkg.sv qv_rs.sv qv_issue.sv qv_rob.sv kill_props.sv --top kill_props
prep -top kill_props

[files]
../../../design/pipe/qv_pkg.sv
../../../design/pipe/qv_rs.sv
../../../design/pipe/qv_issue.sv
../../../design/pipe/qv_rob.sv
