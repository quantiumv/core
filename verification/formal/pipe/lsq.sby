# qv_lsq with qv_lsu (EARLY, HANDOFF, SB_EN) and a ROB model (lsq_props.sv): deep BMC and covers.
# opw, opw_cover: the same with operands that wait in the queue (LSQ_OPW, O1c); opw is BMC depth 10: the 64-bit operand
# values make each step costly (step 9 alone took 88 minutes of boolector on a loaded machine).
# Run with run.sh, or: sby -f lsq.sby
[tasks]
bmc base
cover base
opw opwg
opw_cover opwg

[options]
bmc: mode bmc
bmc: depth 14
cover: mode cover
cover: depth 20
opw: mode bmc
opw: depth 10
opw_cover: mode cover
opw_cover: depth 20

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
base: read_slang --single-unit qv_pkg.sv qv_pmp.sv qv_lsq.sv qv_lsu.sv lsq_props.sv --top lsq_props
opwg: read_slang --single-unit -D LSQ_OPW qv_pkg.sv qv_pmp.sv qv_lsq.sv qv_lsu.sv lsq_props.sv --top lsq_props
prep -top lsq_props

[files]
../../../design/pipe/qv_pkg.sv
../../../design/pipe/qv_pmp.sv
../../../design/pipe/qv_lsq.sv
../../../design/pipe/qv_lsu.sv
lsq_props.sv
