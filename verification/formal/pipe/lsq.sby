# qv_lsq with qv_lsu (EARLY, HANDOFF, SB_EN) and a ROB model (lsq_props.sv): deep BMC and covers.
# Run with run.sh, or: sby -f lsq.sby
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 14
cover: mode cover
cover: depth 20

[engines]
smtbmc boolector

[script]
plugin -i /home/potato/yosys-slang-src/build/slang.so
read_slang --single-unit qv_pkg.sv qv_pmp.sv qv_lsq.sv qv_lsu.sv lsq_props.sv --top lsq_props
prep -top lsq_props

[files]
../../../design/pipe/qv_pkg.sv
../../../design/pipe/qv_pmp.sv
../../../design/pipe/qv_lsq.sv
../../../design/pipe/qv_lsu.sv
lsq_props.sv
