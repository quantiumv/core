+# quantiumv/core patch: rvfi_mem_rdata sliced to [31:0] here (stock upstream
+# compares it unsliced). This core sign-extends the .W old value into
+# rvfi_mem_rdata (correctly -- that is what makes the $signed() compares
+# above work across every alignment). But an unsliced *unsigned* < / >
+# against that same sign-extended 64-bit value is wrong: a sign-extended
+# negative-as-32-bit old value reads as a huge unsigned 64-bit number, so
+# the comparison picks the wrong winner even though the core is correct.
+# Slicing to [31:0] matches the true 32-bit unsigned semantics of
+# AMOMINU.W/AMOMAXU.W regardless of what sits in the upper bits.
+insn_amo("amominu_w", "11000", "010", "rvfi_mem_rdata[31:0] < rvfi_rs2_rdata[31:0] ? rvfi_mem_rdata : rvfi_rs2_rdata[31:0]")
+insn_amo("amomaxu_w", "11100", "010", "rvfi_mem_rdata[31:0] > rvfi_rs2_rdata[31:0] ? rvfi_mem_rdata : rvfi_rs2_rdata[31:0]")
+
+current_isa = ["rv64ia"]

