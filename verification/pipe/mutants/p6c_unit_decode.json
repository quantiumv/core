 ],
 "cwd": "design",
 "timeout": 900,
 "mutants": [
  {
   "name": "a Program Buffer run is PMP-checked",
   "old": "    wire pmp_fault = !i_pb_active && (!exec_ok_lo || (fetch_hi_taken && !exec_ok_hi));",
   "new": "    wire pmp_fault = !exec_ok_lo || (fetch_hi_taken && !exec_ok_hi);"
  },
  {
   "name": "the PMP is off for everyone",
   "old": "    wire pmp_fault = !i_pb_active && (!exec_ok_lo || (fetch_hi_taken && !exec_ok_hi));",
   "new": "    wire pmp_fault = 1'b0;"
  },
  {
   "name": "only the first span is exempt in a run",
   "old": "    wire pmp_fault = !i_pb_active && (!exec_ok_lo || (fetch_hi_taken && !exec_ok_hi));",
   "new": "    wire pmp_fault = (!i_pb_active && !exec_ok_lo) || (fetch_hi_taken && !exec_ok_hi);"
  }
 ]
}
