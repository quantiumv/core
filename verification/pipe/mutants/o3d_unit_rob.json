  {
   "name": "this cycle's retirements survive",
   "old": "            p = head_next + PTR_W'(j);",
   "new": "            p = head_q + PTR_W'(j);"
  },
  {
   "name": "the branch does not survive",
   "old": "(QV_ROB_TAG_W'(j) < n_surv)",
   "new": "(QV_ROB_TAG_W'(j) + 1 < n_surv)"
  },
  {
   "name": "x0 is claimed",
   "old": "o_surv_int[j]  = rd_wen_q[x] && !c.rd_fp && (rd_q[x] != 5'd0);",
   "new": "o_surv_int[j]  = rd_wen_q[x] && !c.rd_fp;"
  },
  {
   "name": "a survivor tag without its wrap bit",
   "old": "o_surv_tag[j]  = QV_ROB_TAG_W'(p);",
   "new": "o_surv_tag[j]  = QV_ROB_TAG_W'(x);"
  },
  {
   "name": "every survivor is a CSR op",
   "old": "o_surv_csr[j]  = (c.cls == QV_FU_CSR);",
   "new": "o_surv_csr[j]  = 1'b1;"
  }
 ]
