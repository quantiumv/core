 "mutants": [
  {
   "name": "the killed entries survive too",
   "old": "QV_ROB_TAG_W'(kill_from), QV_ROB_TAG_W'(head_next), PTR_W);\n    always_comb",
   "new": "QV_ROB_TAG_W'(tail_q), QV_ROB_TAG_W'(head_next), PTR_W);\n    always_comb"
