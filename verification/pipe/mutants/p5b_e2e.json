  {
   "name": "LR never sets the reservation (is_lr dropped)",
   "file": "qv_issue.sv",
   "old": "o_alloc_ctrl.is_lr     = i_uop.is_atomic && i_uop.amo_op == QV_AMO_LR && !i_uop.xcpt;",
   "new": "o_alloc_ctrl.is_lr     = 1'b0;"
  },
  {
   "name": "plain stores do not clear the reservation",
   "file": "qv_issue.sv",
   "old": "o_alloc_ctrl.is_store_class = (i_uop.is_store || (i_uop.is_atomic && i_uop.amo_op != QV_AMO_LR))",
   "new": "o_alloc_ctrl.is_store_class = ((i_uop.is_atomic && i_uop.amo_op != QV_AMO_LR))"
  },
  {
   "name": "SC does not clear the reservation",
   "file": "qv_issue.sv",
   "old": "o_alloc_ctrl.is_store_class = (i_uop.is_store || (i_uop.is_atomic && i_uop.amo_op != QV_AMO_LR))",
   "new": "o_alloc_ctrl.is_store_class = (i_uop.is_store || (i_uop.is_atomic && i_uop.amo_op > QV_AMO_SC))"
  },
  {
   "name": "AMOs do not clear the reservation",
   "file": "qv_issue.sv",
   "old": "o_alloc_ctrl.is_store_class = (i_uop.is_store || (i_uop.is_atomic && i_uop.amo_op != QV_AMO_LR))",
   "new": "o_alloc_ctrl.is_store_class = (i_uop.is_store || (i_uop.is_atomic && i_uop.amo_op == QV_AMO_SC))"
  },
  {
   "name": "a faulting LR sets the reservation",
   "file": "qv_commit.sv",
   "old": "end else if (commit && i_head_ctrl.is_lr && !is_trap) begin",
   "new": "end else if (commit && i_head_ctrl.is_lr) begin"
  },
  {
   "name": "reservation address is the aligned address",
   "file": "qv_commit.sv",
   "old": "res_addr_q  <= i_lsu_res.vaddr;",
   "new": "res_addr_q  <= {i_lsu_res.vaddr[63:3], 3'b000};"
  },
  {
   "name": "AMOMIN and AMOMAX swapped in decode",
   "file": "qv_decode.sv",
   "old": "`INSTR_CODE(AMOMIN_W):  begin amo_op = QV_AMO_MIN;  atomic_word = 1'b1; end",
