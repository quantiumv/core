  {
   "name": "SC always sees a reservation",
   "file": "core_pipe.sv",
   "old": ".i_res_valid(res_valid), .i_res_addr(res_addr),",
   "new": ".i_res_valid(1'b1), .i_res_addr(res_addr),"
