  {
   "name": "AMOMAXU.D decoded as AMOMINU",
   "file": "qv_decode.sv",
   "old": "`INSTR_CODE(AMOMAXU_D): begin amo_op = QV_AMO_MAXU; end",
   "new": "`INSTR_CODE(AMOMAXU_D): begin amo_op = QV_AMO_MINU; end"
  },
  {
   "name": "AMOADD.W treated as a doubleword",
   "file": "qv_decode.sv",
   "old": "`INSTR_CODE(AMOADD_W):  begin amo_op = QV_AMO_ADD;  atomic_word = 1'b1; end",
   "new": "`INSTR_CODE(AMOADD_W):  begin amo_op = QV_AMO_ADD; end"
  },
  {
   "name": "SC.W treated as a doubleword",
   "file": "qv_decode.sv",
   "old": "`INSTR_CODE(SC_W):      begin amo_op = QV_AMO_SC;   atomic_word = 1'b1; end",
   "new": "`INSTR_CODE(SC_W):      begin amo_op = QV_AMO_SC; end"
  },
  {
   "name": "LR.D treated as LR.W",
   "file": "qv_decode.sv",
   "old": "`INSTR_CODE(LR_D):      begin amo_op = QV_AMO_LR; end",
