{
 "dut": "design/pipe/qv_fetch.sv",
 "tb": "design/pipe/qv_fetch_stream_tb.sv",
 "files": [
  "design/pipe/qv_pkg.sv",
  "design/pipe/qv_fetch.sv"
 ],
 "flags": [
  "-g2012",
  "-I",
  ".",
  "-I",
  "defaults",
  "-I",
  "../testbench"
 ],
 "cwd": "design",
 "timeout": 900,
 "mutants": [
  {
   "name": "stream through a redirect",
   "old": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;",
   "new": "wire stream_go = STREAM && can_issue && bus_resp && !i_xl_on && !i_yield;"
  },
  {
   "name": "stream with translation on",
   "old": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;",
   "new": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_yield;"
  },
  {
   "name": "stream through a yield",
   "old": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;",
   "new": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on;"
  },
  {
   "name": "stream without the room and hold check",
   "old": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;",
   "new": "wire stream_go = STREAM && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;"
  },
  {
   "name": "stream only on an ack, not on an error",
   "old": "wire stream_go = STREAM && can_issue && bus_resp && !i_redirect_valid && !i_xl_on && !i_yield;",
   "new": "wire stream_go = STREAM && can_issue && wb_fetch_ack_i && !wb_fetch_err_i && !i_redirect_valid && !i_xl_on && !i_yield;",
   "equivalent": true,
   "note": "unobservable: only the rate after an error answer differs"
  },
  {
   "name": "the stream presents the old address",
   "old": "assign wb_fetch_addr_o = stream_go  ? {fpc_q[31:3], 3'b000}",
   "new": "assign wb_fetch_addr_o = stream_go  ? {req_pc_q[31:3], 3'b000}"
  },
  {
   "name": "cyc dropped in the answer's cycle",
   "old": "assign wb_fetch_cyc_o  = bus && (!(wb_fetch_ack_i || wb_fetch_err_i) || stream_go);",
   "new": "assign wb_fetch_cyc_o  = bus && !(wb_fetch_ack_i || wb_fetch_err_i);"
  },
  {
   "name": "room for one response too few",
   "old": "(fb_count_next < CNT_W'(FB_DEPTH))",
   "new": "(fb_count_next <= CNT_W'(FB_DEPTH))"
  },
  {
   "name": "a stale answer is not dropped when streaming",
   "old": "wire resp_ok  = resp && !req_stale_q && !i_redirect_valid;",
   "new": "wire resp_ok  = resp && !i_redirect_valid;"
  },
  {
   "name": "a held fetch streams",
   "old": "&& (fb_count_next < CNT_W'(FB_DEPTH)) && !i_hold",
   "new": "&& (fb_count_next < CNT_W'(FB_DEPTH)) && (!i_hold || bus_resp)"
  }
 ]
}