{
 "dut": "design/pipe/qv_fpu_pipe.sv",
 "tb": "design/pipe/qv_fpu_vec_tb.sv",
 "files": ["design/pipe/qv_pkg.sv", "design/pipe/qv_fp_dec.sv", "design/pipe/qv_fpu_round.sv",
           "design/pipe/qv_fpu_pipe.sv", "design/pipe/qv_fpu_divsqrt.sv"],
 "flags": ["-g2012", "-I", ".", "-I", "defaults"],
 "cwd": "design",
 "plusargs": ["+VEC=../verification/fpu/vectors/smoke.vec"],
 "timeout": 900,
 "mutants": [
  {"name": "inf * 0 is not invalid", "old": "if (ocls == QV_FPC_ZERO) begin", "new": "if (1'b0) begin"},
  {"name": "FMUL of a zero takes the zero-sum sign rule", "old": "if (!has_z)                     a_res = zerov(r0.fmt, sp);", "new": "if (1'b0)                       a_res = zerov(r0.fmt, sp);"},
  {"name": "0 + 0 with opposite signs ignores RDN", "old": "(sp == sc) ? sp : (r0.rm == 3'd2)", "new": "(sp == sc) ? sp : 1'b0"},
  {"name": "an exact zero sum ignores RDN", "old": "c_res  = zerov(r2_fmt, r2_rm == 3'd2);", "new": "c_res  = zerov(r2_fmt, 1'b0);"},
  {"name": "a jammed addend loses its sticky bit", "old": "a_c  = W'(uz.m >> k) | W'((uz.m & lost) != 53'b0);", "new": "a_c  = W'(uz.m >> k);"},
  {"name": "an addend far below the window is dropped", "old": "a_c = W'(1);", "new": "a_c = '0;"},
  {"name": "the product far below the addend is dropped", "old": "a_p    = W'(1);", "new": "a_p    = '0;"},
  {"name": "the window boundary off by one", "old": "if (sh > 14'sd111) begin", "new": "if (sh > 14'sd112) begin"},
  {"name": "a negative difference keeps the product's sign", "old": "b_s = r1_sc;", "new": "b_s = r1_sp;"},
  {"name": "the normalized exponent off by one", "old": "c_e  = r2_qacc + 14'(W - lz)", "new": "c_e  = r2_qacc + 14'(W - lz + 1)"},
  {"name": "normalizing drops the sticky bits", "old": "c_st = xn[W-55:0] != '0;", "new": "c_st = 1'b0;"},
  {"name": "FMSUB does not negate the addend", "old": "neg_c    = r0.op == QV_FP_MSUB || ", "new": "neg_c    = "},
  {"name": "min/max with an sNaN raises no NV", "old": "a_flags = (ux.cls == QV_FPC_SNAN || uy.cls == QV_FPC_SNAN) ? 5'h10 : 5'h00;", "new": "a_flags = 5'h00;"},
  {"name": "fmin(+0, -0) picks the wrong zero", "old": ": (ux.s ? xa : xb));", "new": ": (ux.s ? xb : xa));"},
  {"name": "FEQ signals on a quiet NaN", "old": "(r0.op != QV_FP_EQ || ux.cls", "new": "(1'b1 || ux.cls"},
  {"name": "FLE is FLT", "old": "(flt(r0.fmt, xa, xb) || feq(r0.fmt, xa, xb))", "new": "flt(r0.fmt, xa, xb)"},
  {"name": "classify swaps subnormal and normal", "old": "QV_FPC_SUB:  a_res = ux.s ? 64'h004 : 64'h020;", "new": "QV_FPC_SUB:  a_res = ux.s ? 64'h002 : 64'h040;"},
  {"name": "FMV.X.W does not sign-extend", "old": "a_res = r0.fmt ? r0.a : sext32(r0.a[31:0]);", "new": "a_res = r0.fmt ? r0.a : {32'b0, r0.a[31:0]};"},
  {"name": "FMV.W.X does not NaN-box", "old": "QV_FP_MV_FX: a_res = boxv(r0.fmt, r0.a);", "new": "QV_FP_MV_FX: a_res = r0.a;"},
  {"name": "FP-to-int of a NaN gives the minimum", "old": "a_res = imax; a_flags = 5'h10;", "new": "a_res = imin; a_flags = 5'h10;"},
  {"name": "an unsigned conversion of a small negative is invalid instead of 0", "old": "(sgn ? (mag2 <= 65'h0_8000_0000) : (mag2 == 65'd0))", "new": "(sgn ? (mag2 <= 65'h0_8000_0000) : 1'b0)"},
  {"name": "an inexact conversion to an integer raises no NX", "old": "a_flags = (g || st) ? 5'h01 : 5'h00;", "new": "a_flags = 5'h00;"},
  {"name": "a 32-bit conversion result is zero-extended", "old": "a_res   = w32 ? sext32(v[31:0]) : v;", "new": "a_res   = w32 ? {32'b0, v[31:0]} : v;"},
  {"name": "FCVT from WU sign-extends", "old": "(r0.ityp == 2'd1) ? {32'b0, r0.a[31:0]}", "new": "(r0.ityp == 2'd1) ? sext32(r0.a[31:0])"},
  {"name": "a conversion between precisions ignores an sNaN", "old": "a_res = canon(r0.fmt); a_flags = (ux.cls == QV_FPC_SNAN) ? 5'h10 : 5'h00;", "new": "a_res = canon(r0.fmt); a_flags = 5'h00;"},
  {"name": "FSGNJN.D uses the sign of rs1", "old": "(r0.op == QV_FP_SGNJN) ? !xb[63]", "new": "(r0.op == QV_FP_SGNJN) ? !xa[63]"},
  {"name": "FSGNJX.S ignores rs1's sign", "old": "(xa[31] ^ xb[31])", "new": "(xb[31])"},
  {"name": "a single result is not NaN-boxed", "old": "o_wb.value = r3_done ? r3_res : boxv(r3_fmt, d_res);", "new": "o_wb.value = r3_done ? r3_res : d_res;"}
 ]
}
